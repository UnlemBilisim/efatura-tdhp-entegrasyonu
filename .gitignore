# Python sanal ortamlar
entegrasyon/.venv/
Mcp_mimarisi/.venv/
model_eval/.venv/
.calistirma/mcp_venv/
**/__pycache__/
*.pyc

# npm (paket dağıtımı için eklendi — kod bu depoda Python, node_modules olmaz
# ama npm tooling bazı geçici dosyalar bırakabilir)
node_modules/
*.tgz

# Servis durum/log dosyaları (baslat.sh tarafından üretilir)
.calistirma/*.log
.calistirma/*.pid

# Üretilmiş veri (RAG vektör veritabanı)
model_eval/vector_db/

# Sırlar — sunucuda gerçek parola/env dosyası commit'lenmemeli
.env
.env.*
!.env.example

# İşletim sistemi
.DS_Store

# Excel'in kendi geçici kilit dosyaları (dosya adı ".~" ile başlar)
.~*

# Test/inceleme amaçlı gerçek fatura PDF'leri ve kök dizine düşen başıboş
# XML'ler — gerçek fatura verisi içerir, git'e gömülmez.
pdfler/
*.xml
# İSTİSNA: onboarding_test/ altındaki UYDURMA mock şirket faturaları (sahte VKN, kurgusal fırın şirketi) — güncelleme/orkestrasyon
# testleri (model_eval/tests/test_musteri_guncelle_orkestrasyon.py) bunlara bağlı; commit'lenmezse temiz klonda/CI'da testler düşer.
!onboarding_test/**/*.xml

# Muhtemelen hassas/kişisel veri — içeriği doğrulanmadan commit'lenmiyor
Archive2/

# PostgreSQL yedekleri — gerçek fatura verisi içerir, git'e gömülmez.
# Sunucuya ayrı, güvenli bir kanaldan (scp/rsync) taşınmalı.
db-yedek/

# Makineye özel geçici Docker Compose override (ör. paylaşılan GPU
# sunucusunda port çakışmasını önlemek için) — kalıcı/paylaşılan
# yapılandırma değil, commit'lenmemeli.
docker-compose.override.yml
.calistirma
